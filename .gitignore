# Arduino / arduino-cli build output
build/
*.elf
*.map

# Python
__pycache__/
*.pyc
.venv/
venv/

# Trainer outputs. The committed contract lives in 03_deployment/ (placeholders until
# you train); what train.py drops in training/ is a build artefact you copy across.
training/model.h
training/scaler.h
training/pipeline.joblib
training/report/*.png
training/report/*.json
training/report/*.txt

# Your own collected datasets stay local unless you deliberately add them.
# The generated SYNTHETIC_sample.csv is committed so a fresh clone can train.
training/data/*.csv
!training/data/SYNTHETIC_sample.csv

# OS noise
Thumbs.db
.DS_Store
desktop.ini
